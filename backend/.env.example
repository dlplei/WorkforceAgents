# Workforce Operations Agent 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# LLM API 配置
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-api-key-here
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# 后端服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
