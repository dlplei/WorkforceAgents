# LLM API 配置
# 复制此文件为 .env 并填入实际值

# API Base URL (OpenAI 兼容接口)
LLM_BASE_URL=https://api.openai.com/v1

# API Key (必填)
LLM_API_KEY=sk-your-api-key-here

# 模型名称
LLM_MODEL=gpt-4o-mini

# 温度参数 (0.0-2.0，越高越随机)
LLM_TEMPERATURE=0.7

# 最大 token 数
LLM_MAX_TOKENS=2048

# 后端服务配置
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
